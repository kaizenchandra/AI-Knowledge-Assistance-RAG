ENVIRONMENT=development
# Generate random values, e.g. openssl rand -hex 32. Never commit .env.
DB_PASSWORD=replace-with-random-hex
DEV_TOKEN=replace-with-random-hex
PROVIDER=offline
STORAGE=local
CORS_ORIGIN=http://localhost:3000
# Live provider mode:
OPENAI_API_KEY=
CHAT_MODEL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
PINECONE_API_KEY=
PINECONE_INDEX=knowledge
PINECONE_HOST=
# Production identity and storage:
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
S3_BUCKET=
AWS_REGION=us-east-1
# Ingestion protection (required outside development):
SCAN_MODE=disabled
CLAMD_HOST=clamav
CLAMD_PORT=3310
SCAN_TIMEOUT=30
PARSER_TIMEOUT=20
PARSER_MEMORY_MB=512
UPLOAD_TIMEOUT=30
# Optional S3-compatible endpoint, e.g. local MinIO:
S3_ENDPOINT_URL=
